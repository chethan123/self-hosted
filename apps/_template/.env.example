# Copy to .env on the app VM, fill in real values. .env is gitignored.
# Keep EXHAUSTIVE — every key the stack needs — so `cp .env.example .env && edit && up` never
# hits a missing-variable error. Non-secret config can keep real defaults here.

SIDECAR_PORT=80

# --- linuxserver.io images only: delete `user:` in compose ---
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- app config, non-secret ---
# APP_LOG_LEVEL=info

# --- secrets: prefer file-secrets (./secrets/*.txt) for high-value values.
#     Only put a secret here if the image accepts it ONLY via env var.
#     Generate: openssl rand -base64 24
# SOME_API_KEY=changeme
