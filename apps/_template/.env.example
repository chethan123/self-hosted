# Copy to .env on the app VM, fill in real values. .env is gitignored.
# Keep EXHAUSTIVE — every key the stack needs — so `cp .env.example .env && edit && up` never
# hits a missing-variable error. Non-secret config can keep real defaults here.

# Both compose files, always (ADR-0006): the app's own, and the backup half.
COMPOSE_FILE=docker-compose.yml:docker-compose.backup.yml

SIDECAR_PORT=80
# Real base domain, no scheme — the backup sidecar's repositories live at backup.<it>.
BASE_DOMAIN=example.com

# --- linuxserver.io images only: delete `user:` in compose ---
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- app config, non-secret ---
# APP_LOG_LEVEL=info

# --- secrets: prefer file-secrets (./secrets/*.txt) for high-value values.
#     Only put a secret here if the image accepts it ONLY via env var.
#     Generate: openssl rand -base64 24
# SOME_API_KEY=changeme

# --- backups (docker-compose.backup.yml; docs/specs/backup-sidecar.md) ------------------------
# The account owning EVERY path under /backup — the LITERAL numbers `id -u` / `id -g` print (a
# .env is not a shell). The dump service runs as it too. Usually the app's own uid; must not be 0.
BACKUP_UID=
BACKUP_GID=
# Uptime Kuma push URL for this app's monitor (…/api/push/<token>; the query is rebuilt per run).
# `none` runs unmonitored — explicitly.
BACKUP_PING_URL=
# Cron, UTC — after the dump (DUMP_AT) has had time to finish. Default in docker-compose.backup.yml.
#BACKUP_SCHEDULE=0 3 * * *
# The dump service: UTC hour, retention window, pg_dump compression. `false` exits 0 and stays exited.
#DUMP_ENABLED=true
#DUMP_AT=02
#DUMP_KEEP_DAYS=7
#DUMP_COMPRESS=0
