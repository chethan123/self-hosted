# Copy to .env on the portfolio VM and fill in real values. .env is gitignored.
# Keep this file EXHAUSTIVE — every key the stack needs — so `cp .env.example .env && edit && up`
# never hits a missing-variable error. Non-secret config can keep real defaults here.
#
# Every required key below is interpolated as ${VAR:?...} in docker-compose.yml: `up` refuses and
# names the variable rather than starting half-protected. That fail-fast is why secrets_mode is
# `env` here and not the house default `hybrid` — see app.meta.yaml.

# --- routing ---------------------------------------------------------------------------------
SIDECAR_PORT=80

# Real base domain, no scheme, no subdomain, no port, no trailing dot or slash. The app's public
# origin is composed from it as https://portfolio.${BASE_DOMAIN} — in canonical form, because the
# gate's redirect URI and the lock's relying-party id (upstream ADR-0012) compare it verbatim.
# The app refuses a non-canonical origin at startup and names it; a trailing dot or an explicit
# port slips past that check and surfaces later as Google's redirect_uri_mismatch.
BASE_DOMAIN=example.com

# --- secrets (required — no defaults) --------------------------------------------------------
# Seeds the `portfolio` role at initdb, then serves as `app`/`dump`'s PGPASSWORD.
# Generate: openssl rand -hex 32
# Changing it on a running instance takes more than editing this line — upstream docs/operating.md.
POSTGRES_PASSWORD=

# The gate (oauth2-proxy) — upstream docs/google-sign-in.md. The redirect URI registered on the
# OAuth client must be exactly https://portfolio.${BASE_DOMAIN}/oauth2/callback
GATE_CLIENT_ID=
GATE_CLIENT_SECRET=

# Session-cookie key; must decode to 16, 24 or 32 bytes, or the gate won't start.
# Generate: openssl rand -base64 32 | tr -- '+/' '-_'
# Rotating signs every device out.
GATE_COOKIE_SECRET=

# --- the nightly dump (required half) --------------------------------------------------------
# The account owning ./volumes/dumps — the LITERAL numbers `id -u` / `id -g` print. A .env is not
# a shell: `$(id -u)` is stored verbatim and the container fails to create. Must not be 0 —
# scripts/dump-loop.sh refuses to run as root. Blank on purpose: copying this file must not hand
# you someone else's account.
DUMP_UID=
DUMP_GID=

# --- optional — defaults shown ---------------------------------------------------------------
# Leave it unset. The default below is the real one; the commented example is NOT a default.
# Pointing it off-box does not work here: upstream's compose.external-db.yaml — the override that
# gives `app` a route out — is not vendored, so `app` stays on two internal networks and fails
# with ENOTFOUND, while `dump` refuses any host but `db` and crash-loops.
# A password written into the URL wins over PGPASSWORD.
#DATABASE_URL=postgres://portfolio@db:5432/portfolio

# `2` floats with every v2.x.y and `up -d` rolls forward; pin a full version to hold still or
# roll back. The tag never crosses a major: going to v3 is a deliberate APP_VERSION=3 after
# reading upstream's release notes. Do NOT set 1 — this is upstream's v2 compose, and the v1
# image has no server/price-worker.ts or server/egress-proxy.ts, so `worker` and `egress-proxy`
# crash-loop while everything else goes green. One of two floating tags — see app.meta.yaml.
#APP_VERSION=2

# HTTP listen port inside the compose networks — `caddy` reads it too as APP_PORT. Not the
# published host port; that is SIDECAR_PORT above.
#PORT=3000

# IANA zone: the scheduled quote window around regular market hours, and which trading day a
# quote belongs to — UTC would file an evening mutual-fund NAV a day late. Storage stays UTC.
#MARKET_TIMEZONE=America/New_York

# Container clock; log lines only. `db` and `dump` pin UTC regardless — DUMP_AT is a UTC hour.
#TZ=UTC

# false exits 0 and stays exited, so bare `docker compose ps` won't list `dump`.
#DUMP_ENABLED=true

# UTC hour, two digits.
#DUMP_AT=02

# A hand-off window, not your history: how long your backup tool can be broken.
#DUMP_KEEP_DAYS=7

# 0-9, or `none`. Uncompressed by default so a deduplicating backup tool sees a stable byte
# stream. The run refuses rather than filling the database's disk.
#DUMP_COMPRESS=0

# --- not here, on purpose --------------------------------------------------------------------
# PUBLIC_ORIGIN: composed in docker-compose.yml as https://portfolio.${BASE_DOMAIN}. Upstream
# takes it whole; here BASE_DOMAIN is the single parameter (golden rule 4), and deriving it beats
# an operator retyping an origin the OAuth client compares character-for-character.
#
# AUTH_GATE: hardcoded `external` in docker-compose.yml — `gate` is right there. It describes the
# deployment, it does not switch anything on.
#
# The allowlist of who may sign in is ./secrets/allowed-emails.txt, not a variable. Copy
# allowed-emails.example.txt to it; `up` fails if it is missing.
#
# MAX_UPLOAD_MB, PRICE_WORKER_SOCKET: upstream keys that compose does not wire through. The first
# keeps its 10 MiB default; the second is for a worker run outside Compose.
