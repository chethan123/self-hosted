# Copy to .env on the app VM and fill in real values. .env is gitignored.
# Keep this file EXHAUSTIVE — every key the stack needs — so `cp .env.example .env && edit && up`
# never hits a missing-variable error. Non-secret config can keep real defaults here.

# --- routing ---
SIDECAR_PORT=80

# --- storage targets ---------------------------------------------------------------------
# Host directory backing each URL path segment. Directory name after the last slash is
# cosmetic — what matters: container mount is /data/<target>, and <target> is also the
# htpasswd username (--private-repos). Both must be owned by uid:gid 1000:1000.
#
#   RESTIC_LOCAL_PATH    -> /data/local     -> https://restic.<domain>/local/<machine>/
#   RESTIC_RCLONE1_PATH  -> /data/rclone-1  -> https://restic.<domain>/rclone-1/<machine>/
#
# RESTIC_RCLONE1_PATH must be a host rclone mount's mountpoint (README); bind-mounted rshared
# so remounts propagate into the container.
RESTIC_LOCAL_PATH=/srv/restic/local
RESTIC_RCLONE1_PATH=/srv/restic/rclone-1

# --- rest-server tuning ------------------------------------------------------------------
# Appended to docker-compose.yml's hardcoded `--append-only --private-repos` — those two are
# not overridable from here, on purpose. Useful additions:
#   --max-size 500000000000   per-repo quota in bytes
#   --prometheus              expose /metrics
#   --debug                   verbose request logging
RESTIC_EXTRA_OPTIONS=

# --- misc ---
TZ=Etc/UTC

# --- secrets ------------------------------------------------------------------------------
# None live here. The only secret is the bcrypt htpasswd file at ./secrets/htpasswd, mounted
# as a file-secret at /run/secrets/htpasswd. Generate it per the README.
