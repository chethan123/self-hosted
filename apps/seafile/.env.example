# Copy to .env on the seafile VM and fill in real values. .env is gitignored.
# Keep this file EXHAUSTIVE — every key the stack needs — so `cp .env.example .env && edit && up`
# never hits a missing-variable error. Non-secret config can keep real defaults here.
#
# secrets_mode: env, forced not preferred — the image reads every credential via os.getenv
# (bootstrap.py), no *_FILE convention, so a file-secret would cover only MariaDB while the same
# value still sat in seafile's environment. Protect this file instead: chmod 600 — it's the
# single thing to guard on this VM.

# --- routing ---------------------------------------------------------------------------------
SIDECAR_PORT=80

# Must match global-caddy/sites/files.caddy exactly. Baked into share links and client sync
# config at first boot — changing it later means editing the database.
SEAFILE_SERVER_HOSTNAME=files.example.com

# https: Global Caddy terminates TLS, even though this VM only ever speaks plain HTTP internally.
SEAFILE_SERVER_PROTOCOL=https

SITE_ROOT=/

# --- container identity ------------------------------------------------------------------------
# false for FIRST boot only, then true forever after — order matters (README "Non-root
# bring-up"). true on a fresh volume works, but leaves the data tree world-writable
# (bootstrap.py runs `chmod -R a+rwx /shared/`).
NON_ROOT=false

# --- misc ------------------------------------------------------------------------------------
TZ=America/Los_Angeles
TIME_ZONE=America/Los_Angeles

# Keep false: logs land in ./volumes/seafile/seafile/logs/, rotated by the container's own
# logrotate cron. true routes them to `docker logs` (rotated by the json-file driver instead).
SEAFILE_LOG_TO_STDOUT=false

# Default since v12, faster than the legacy python fileserver. Leave on.
ENABLE_GO_FILESERVER=true

# File cap for the built-in metadata server.
MD_FILE_COUNT_LIMIT=100000

# --- database (MariaDB) ------------------------------------------------------------------------
SEAFILE_MYSQL_DB_HOST=db
SEAFILE_MYSQL_DB_PORT=3306
SEAFILE_MYSQL_DB_USER=seafile
SEAFILE_MYSQL_DB_CCNET_DB_NAME=ccnet_db
SEAFILE_MYSQL_DB_SEAFILE_DB_NAME=seafile_db
SEAFILE_MYSQL_DB_SEAHUB_DB_NAME=seahub_db

# `seafile` DB user's password. Permanent, needed every boot. openssl rand -base64 24
SEAFILE_MYSQL_DB_PASSWORD=changeme

# --- cache (Redis) -----------------------------------------------------------------------------
CACHE_PROVIDER=redis
REDIS_HOST=redis
REDIS_PORT=6379

# Permanent, needed every boot — Redis refuses to start without it (compose asserts it).
# openssl rand -base64 24
REDIS_PASSWORD=changeme

# --- first-boot only ---------------------------------------------------------------------------
# Read ONLY when the stack first initialises:
#   - MariaDB ignores the root password once /var/lib/mysql exists
#   - Seafile writes the admin account, then start.py deletes conf/admin.txt
# Keeping them here keeps a rebuild-from-scratch reproducible. Blanking both after a successful
# first boot is optional (README, "Optional: retire the first-boot values") — costs one extra
# step if you ever re-initialise from empty volumes.

# openssl rand -base64 24
INIT_SEAFILE_MYSQL_ROOT_PASSWORD=changeme

INIT_SEAFILE_ADMIN_EMAIL=admin@example.com
INIT_SEAFILE_ADMIN_PASSWORD=changeme

# --- JWT ---------------------------------------------------------------------------------------
# Signs internal service-to-service tokens. Minimum 32 chars, permanent. openssl rand -hex 32
JWT_PRIVATE_KEY=changeme-at-least-32-characters-long

# --- not here, on purpose ----------------------------------------------------------------------
# ENABLE_SEADOC / ENABLE_NOTIFICATION_SERVER / ENABLE_SEAFILE_AI / ENABLE_FACE_RECOGNITION:
# hardcoded false in docker-compose.yml instead — structural to this package, so a stray edit to
# this gitignored file can't half-enable an undeployed component.
#
# SEAFILE_SERVER_LETSENCRYPT: upstream's in-container ACME. Never used — Global Caddy owns TLS.

# --- email: NOT ENABLED (requires egress) ------------------------------------------------------
# needs_egress=false: seafile sits on internal-only frontend+backend, reaching neither the
# internet nor a LAN mail relay. Deliberate.
#
# Consequences: no self-service password reset, no share-link emails, no invites, no admin
# alerts. Workaround: admin sets passwords from the web admin panel; share links still work,
# just copy-pasted by hand.
#
# TO ENABLE LATER:
#   1. docker-compose.yml: add `edge` to seafile's `networks:` — the one change that gives it
#      outbound reach, so do it consciously; then set needs_egress: true in app.meta.yaml.
#   2. Uncomment and fill in the block below, then append the matching EMAIL_* settings to
#      ./volumes/seafile/seafile/conf/seahub_settings.py (Seafile reads mail config from there,
#      not the environment) and restart.
#
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=seafile@example.com
# EMAIL_HOST_PASSWORD=changeme
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=seafile@example.com
# SERVER_EMAIL=seafile@example.com
