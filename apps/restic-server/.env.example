# Copy to .env on the restic-server VM and fill in real values. .env is gitignored.
# Keep this file EXHAUSTIVE — every key the stack needs — so `cp .env.example .env && edit && up`
# never hits a missing-variable error. Non-secret config can keep real defaults here.

# --- routing ---------------------------------------------------------------------------------
SIDECAR_PORT=443
# Read by the sidecar's site header (Caddyfile) AND the global-caddy fragment's tls_server_name.
# Unset, `tls internal` has nothing to issue a certificate for.
BASE_DOMAIN=example.com

# --- storage: NFS, the `nfs` target ------------------------------------------------------------
# Holds /export/restic. That export must be created and owned 1000:1000 before first start,
# without squashing that UID into `nobody` — see README "Operator prerequisites".
NFS_SERVER=192.168.86.250

# --- storage: rsync.net, the `rsync-net` target -------------------------------------------------
# Host, user, SSH key and host key all live in file-secrets (secrets/rclone-rsync-net.conf,
# secrets/rsync-net.key, secrets/rsync-net.known_hosts) — never here. Only the remote's root path
# is compose-file config, and per spec §13 it is a genuine placeholder until you have a real
# rsync.net account: no leading slash (rsync.net requirement). Replace CHANGEME below; see
# README "Building the secrets" for the file-secrets themselves.
RSYNC_NET_REMOTE_PATH=CHANGEME-user/restic-server

# --- app-facing credentials (file-secrets, not env vars) ----------------------------------------
# The three htpasswd files (secrets/htpasswd-{nfs,rsync-net,pcloud}) seed one bcrypt line per
# onboarded app, username = app slug. This package ships no real ones — see README
# "Onboarding a new app" for the placeholder slug used there and how to add a real one.
