# Copy to .env on the jellyfin VM and fill in real values. .env is gitignored.
# Keep this file EXHAUSTIVE — every key the stack needs — so `cp .env.example .env && edit && up`
# never hits a missing-variable error. Non-secret config can keep real defaults here.

# --- routing -------------------------------------------------------------------------------
SIDECAR_PORT=80

# Read by the sidecar's host matchers AND by JELLYFIN_PublishedServerUrl. Unset, every subdomain
# on this VM returns the sidecar's 404. No scheme, no leading dot.
BASE_DOMAIN=example.com

# --- storage -------------------------------------------------------------------------------
# Holds /export/jellyfin, /export/jellyfin-share, /export/youtube.
NFS_SERVER=192.168.86.250

# --- VPN (gluetun) -------------------------------------------------------------------------
# Comma-separated ProtonVPN exit countries. The WireGuard private key is NOT here — it is a
# file-secret at ./secrets/wireguard_private_key (see README).
VPN_SERVER_COUNTRIES=Switzerland,Netherlands,Sweden,Norway,Portugal,Spain

# --- rclone WebDAV (jellyshare) ------------------------------------------------------------
# Passed to rclone via the shell, so they stay out of the container's command line.
RCLONE_USER=CHANGEME
RCLONE_PASS=CHANGEME

# --- Jellystat + its Postgres --------------------------------------------------------------
# POSTGRES_PASSWORD is read by BOTH jellystat and jellystat-db — one key, so they cannot drift.
# Jellystat has no *_FILE support, hence an env value rather than a file-secret.
POSTGRES_DB=jfstat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME

# Jellystat session signing key. Generate with: openssl rand -hex 32
JWT_SECRET=CHANGEME

# --- misc ----------------------------------------------------------------------------------
TZ=America/Los_Angeles

# --- secrets -------------------------------------------------------------------------------
# One file-secret: ./secrets/wireguard_private_key, read natively by gluetun. Never commit it.
