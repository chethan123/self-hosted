# Copy to .env on the audiobookshelf VM and fill in real values. .env is gitignored.
# Keep this file EXHAUSTIVE — every key the stack needs — so `cp .env.example .env && edit && up`
# never hits a missing-variable error. Non-secret config can keep real defaults here.

# --- routing ---------------------------------------------------------------------------------
SIDECAR_PORT=80

# --- storage ---------------------------------------------------------------------------------
# Holds /export/audiobooks and /export/podcasts.
NFS_SERVER=192.168.86.250

# --- misc ------------------------------------------------------------------------------------
TZ=America/Los_Angeles

# --- not here, on purpose --------------------------------------------------------------------
# PUID/PGID: hardcoded as `user: "975:975"` in docker-compose.yml — must match ownership of the
# NFS exports and ./volumes bind mounts; drifting in a gitignored file is a silent perms failure.
#
# SERVICE_NAME: source stack set it; nothing read it. Dropped.
#
# Secrets: none. Admin account lives in its own db under ./volumes/audiobookshelf/config — no
# file-secret, no secrets: block.
