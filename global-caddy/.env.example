# Copy to .env on each Global Caddy VM and fill in real values. .env is gitignored.
BASE_DOMAIN=example.com                 # your real base domain (kept out of git)
ACME_EMAIL=you@example.com              # Let's Encrypt account / expiry notices
# The Cloudflare DNS API token is NOT an env var — it is a file-secret at
# ./secrets/dns_token.txt (gitignored), mounted to /run/secrets/dns_token. See README.
